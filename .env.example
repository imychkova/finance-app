# Скопіюй у .env.local (він у .gitignore) і заповни. Ніколи не коміть реальні значення.
# Особистий токен: https://api.monobank.ua
MONOBANK_TOKEN=
# Адреса Apps Script (…/exec) і ACCESS_CODE з налаштувань застосунку
APP_URL=
APP_CODE=
# Хто записується як автор витрат (має бути в списку «Хто» в Налаштуваннях)
APP_WHO=Я
